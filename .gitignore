config.toml
youtube_token.json
__pycache__/

# 수집·생성 산출물(용량이 크고 재생성 가능)
episodes/*/assets/images/*.jpg
episodes/*/assets/images/*.png
episodes/*/assets/images/*.JPG
episodes/*/assets/voice/*.mp3
episodes/*/assets/voice/*.wav
episodes/*/assets/bgm/*.wav
episodes/*/out/*.mp4
episodes/*/out/*.wav

# 단, 무엇을 썼는지 기록은 남긴다
!episodes/*/assets/images/candidates.json
!episodes/*/assets/voice/timeline.json
client_secret*.json
voice_samples/
.venv/

# 자동 실행 흔적 — 돌릴 때마다 바뀌고 기계마다 다르다
autorun.log
autorun_state.json
